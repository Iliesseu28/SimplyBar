        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en enhet faller til %@ eller lavere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een apparaat daalt tot %@ of minder."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯେତେବେଳେ କୌଣସି ଡିଭାଇସ %@ କିମ୍ବା କମକୁ ଖସେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਕੋਈ ਡੀਵਾਈਸ %@ ਜਾਂ ਘੱਟ ’ਤੇ ਆ ਜਾਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy poziom w urządzeniu spadnie do %@ lub mniej."
