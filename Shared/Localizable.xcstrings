        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBarକୁ ଏପର୍ଯ୍ୟନ୍ତ ବିଜ୍ଞପ୍ତି ପଠାଇବାର ଅନୁମତି ନାହିଁ।"
