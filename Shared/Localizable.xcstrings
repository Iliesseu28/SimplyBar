    "The AI text failed a check and was set aside.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يجتز نص الذكاء الاصطناعي أحد الفحوصات، فتم استبعاده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-এর লেখা একটি যাচাইয়ে উত্তীর্ণ হয়নি, তাই সেটি বাদ দেওয়া হয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El text de la IA no ha superat una comprovació i s’ha descartat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text od AI neprošel kontrolou a byl vyřazen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-teksten bestod ikke et tjek og blev lagt til side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Text hat eine Prüfung nicht bestanden und wurde verworfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο της ΤΝ δεν πέρασε έναν έλεγχο και παραμερίστηκε."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI text failed a check and was set aside."
          }
        },
        "en-CA": {
