    "Processor, memory, disks and heat are within normal limits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعالج والذاكرة والأقراص والحرارة ضمن الحدود الطبيعية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রসেসর, মেমরি, ডিস্ক ও তাপ স্বাভাবিক সীমার মধ্যে আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El processador, la memòria, els discos i la calor estan dins dels límits normals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesor, paměť, disky i zahřátí jsou v normálních mezích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor, hukommelse, diske og varme er inden for normale grænser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozessor, Arbeitsspeicher, Festplatten und Wärme liegen im normalen Bereich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο επεξεργαστής, η μνήμη, οι δίσκοι και η θέρμανση είναι εντός φυσιολογικών ορίων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor, memory, disks and heat are within normal limits."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor, memory, disks and heat are within normal limits."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor, memory, disks and heat are within normal limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesador, la memoria, los discos y el calor están dentro de los límites normales."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesador, la memoria, los discos y el calor están dentro de los límites normales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoritin, muisti, levyt ja lämpö ovat normaaleissa rajoissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur, mémoire, disques et chauffe sont dans les limites normales."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur, mémoire, disques et chauffe sont dans les limites normales."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રોસેસર, મેમરી, ડિસ્ક અને ગરમી સામાન્ય મર્યાદામાં છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המעבד, הזיכרון, הדיסקים והחום נמצאים בטווח התקין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोसेसर, मेमोरी, डिस्क और गर्मी सामान्य सीमा में हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesor, memorija, diskovi i zagrijanost unutar su normalnih granica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A processzor, a memória, a lemezek és a melegedés a normál tartományban van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosesor, memori, disk, dan suhu berada dalam batas normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Processore, memoria, dischi e calore sono nei limiti normali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、メモリ、ディスク、発熱はいずれも正常の範囲内です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರೊಸೆಸರ್, ಮೆಮೊರಿ, ಡಿಸ್ಕ್‌ಗಳು ಮತ್ತು ಬಿಸಿ ಸಾಮಾನ್ಯ ಮಿತಿಯೊಳಗಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, 메모리, 디스크, 발열 모두 정상 범위입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രോസസർ, മെമ്മറി, ഡിസ്കുകൾ, ചൂട് എന്നിവ സാധാരണ പരിധിക്കുള്ളിലാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोसेसर, मेमरी, डिस्क आणि उष्णता सामान्य मर्यादेत आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemproses, memori, cakera dan suhu berada dalam had biasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosessor, minne, disker og varme er innenfor normale grenser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor, geheugen, schijven en warmte zitten binnen de normale grenzen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରୋସେସର, ମେମୋରୀ, ଡିସ୍କ ଏବଂ ଗରମ ସାଧାରଣ ସୀମା ମଧ୍ୟରେ ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰੋਸੈਸਰ, ਮੈਮਰੀ, ਡਿਸਕਾਂ ਅਤੇ ਗਰਮੀ ਆਮ ਸੀਮਾ ਵਿੱਚ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesor, pamięć, dyski i nagrzanie mieszczą się w normie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Processador, memória, discos e calor estão dentro dos limites normais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Processador, memória, discos e calor estão dentro dos limites normais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesorul, memoria, discurile și încălzirea sunt în limite normale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессор, память, диски и нагрев в пределах нормы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesor, pamäť, disky aj zahriatie sú v normálnych medziach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesor, pomnilnik, diski in segretost so v normalnih mejah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor, minne, skivor och värme ligger inom normala gränser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புராசஸர், நினைவகம், டிஸ்க்குகள், வெப்பம் அனைத்தும் இயல்பான வரம்புக்குள் உள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాసెసర్, మెమరీ, డిస్క్‌లు, వేడి అన్నీ సాధారణ పరిమితుల్లోనే ఉన్నాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU หน่วยความจำ ดิสก์ และความร้อนอยู่ในเกณฑ์ปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemci, bellek, diskler ve ısınma normal sınırlar içinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесор, памʼять, диски й нагрів у межах норми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پروسیسر، میموری، ڈسکیں اور حرارت معمول کی حد میں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, bộ nhớ, ổ đĩa và nhiệt độ đều trong giới hạn bình thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、内存、磁盘和发热均在正常范围内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、記憶體、磁碟和發熱皆在正常範圍內。"
          }
        }
      }
    },
    "Questions need Apple Intelligence. The diagnostic above works without it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب الأسئلة Apple Intelligence. يعمل التشخيص أعلاه بدونه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রশ্নের জন্য Apple Intelligence প্রয়োজন। উপরের ডায়াগনস্টিক এটি ছাড়াই কাজ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les preguntes requereixen Apple Intelligence. El diagnòstic de dalt funciona igualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otázky vyžadují Apple Intelligence. Diagnostika výše funguje i bez ní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørgsmål kræver Apple Intelligence. Diagnosen ovenfor virker også uden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen erfordern Apple Intelligence. Die Diagnose oben funktioniert auch ohne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ερωτήσεις απαιτούν Apple Intelligence. Η διάγνωση παραπάνω λειτουργεί και χωρίς αυτήν."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions need Apple Intelligence. The diagnostic above works without it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions need Apple Intelligence. The diagnostic above works without it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions need Apple Intelligence. The diagnostic above works without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preguntas requieren Apple Intelligence. El diagnóstico de arriba funciona igualmente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preguntas requieren Apple Intelligence. El diagnóstico de arriba funciona de todos modos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysymyksiin tarvitaan Apple Intelligence. Yllä oleva diagnoosi toimii ilmankin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions nécessitent Apple Intelligence. Le diagnostic ci-dessus fonctionne sans."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions nécessitent Apple Intelligence. Le diagnostic ci-dessus fonctionne sans."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રશ્નો માટે Apple Intelligence જરૂરી છે. ઉપરનું ડાયગ્નોસ્ટિક તેના વગર પણ કામ કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאלות דורשות Apple Intelligence. האבחון שלמעלה פועל גם בלעדיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रश्नों के लिए Apple Intelligence ज़रूरी है। ऊपर दिया गया डायग्नोस्टिक इसके बिना भी काम करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pitanja je potrebna Apple Intelligence. Dijagnostika iznad radi i bez nje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérdésekhez Apple Intelligence szükséges. A fenti diagnosztika nélküle is működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan memerlukan Apple Intelligence. Diagnostik di atas berfungsi tanpanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domande richiedono Apple Intelligence. La diagnosi qui sopra funziona anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問機能にはApple Intelligenceが必要です。上の診断はApple Intelligenceなしでも動作します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಶ್ನೆಗಳಿಗೆ Apple Intelligence ಬೇಕು. ಮೇಲಿನ ಡಯಾಗ್ನಾಸ್ಟಿಕ್ ಅದಿಲ್ಲದೆಯೂ ಕೆಲಸ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 기능을 사용하려면 Apple Intelligence가 필요합니다. 위의 진단은 Apple Intelligence 없이도 작동합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചോദ്യങ്ങൾക്ക് Apple Intelligence ആവശ്യമാണ്. മുകളിലെ ഡയഗ്നോസ്റ്റിക് അതില്ലാതെയും പ്രവർത്തിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रश्नांसाठी Apple Intelligence आवश्यक आहे. वरील डायग्नोस्टिक त्याशिवायही काम करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soalan memerlukan Apple Intelligence. Diagnostik di atas berfungsi tanpanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørsmål krever Apple Intelligence. Diagnosen ovenfor fungerer også uten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor vragen is Apple Intelligence nodig. De diagnose hierboven werkt ook zonder."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରଶ୍ନ ପାଇଁ Apple Intelligence ଆବଶ୍ୟକ। ଉପରର ଡାଏଗ୍ନୋଷ୍ଟିକ ଏହା ବିନା ମଧ୍ୟ କାମ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਲਾਂ ਲਈ Apple Intelligence ਲੋੜੀਂਦਾ ਹੈ। ਉੱਪਰ ਵਾਲਾ ਡਾਇਗਨੌਸਟਿਕ ਇਸਦੇ ਬਿਨਾਂ ਵੀ ਕੰਮ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytania wymagają Apple Intelligence. Diagnostyka powyżej działa bez niej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As perguntas precisam da Apple Intelligence. O diagnóstico acima funciona sem ela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As perguntas requerem Apple Intelligence. O diagnóstico acima funciona sem ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrebările necesită Apple Intelligence. Diagnosticul de mai sus funcționează și fără."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вопросов нужны функции Apple Intelligence. Диагностика выше работает и без них."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otázky vyžadujú Apple Intelligence. Diagnostika vyššie funguje aj bez nej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za vprašanja je potrebna Apple Intelligence. Diagnostika zgoraj deluje tudi brez nje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågor kräver Apple Intelligence. Diagnosen ovan fungerar ändå."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேள்விகளுக்கு Apple Intelligence தேவை. மேலே உள்ள கண்டறிதல் அது இல்லாமலும் இயங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రశ్నలకు Apple Intelligence అవసరం. పైన ఉన్న డయాగ్నస్టిక్ అది లేకుండానే పనిచేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถามคำถามต้องใช้ Apple Intelligence ส่วนการวินิจฉัยด้านบนใช้งานได้โดยไม่ต้องใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorular için Apple Intelligence gerekir. Yukarıdaki tanılama onsuz da çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для запитань потрібні функції Apple Intelligence. Діагностика вище працює і без них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوالات کے لیے Apple Intelligence درکار ہے۔ اوپر دی گئی تشخیص اس کے بغیر بھی کام کرتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng hỏi đáp cần Apple Intelligence. Phần chẩn đoán ở trên vẫn hoạt động mà không cần đến nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问功能需要 Apple 智能。上方的诊断无需 Apple 智能也能使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提問功能需要 Apple Intelligence。上方的診斷不需要 Apple Intelligence 也能使用。"
          }
        }
      }
    },
