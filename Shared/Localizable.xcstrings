          "stringUnit": {
            "state": "translated",
            "value": "Konverzácia bola príliš dlhá a začala sa odznova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogovor je bil predolg in se je začel znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversationen var för lång och började om."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரையாடல் மிக நீளமாக இருந்ததால் மீண்டும் தொடங்கியது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంభాషణ చాలా పొడవుగా ఉన్నందున మళ్లీ మొదలైంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนทนายาวเกินไปจึงเริ่มต้นใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet çok uzun olduğu için yeniden başladı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмова була задовгою, тому її розпочато заново."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتگو بہت لمبی تھی، اس لیے دوبارہ شروع ہو گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện quá dài nên đã được bắt đầu lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话太长，已重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話太長，已重新開始。"
          }
        }
      }
    },
