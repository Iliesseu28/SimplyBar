    "Requires approval in System Settings > General > Login Items.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الموافقة في إعدادات النظام > عام > عناصر تسجيل الدخول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস > সাধারণ > লগইন আইটেম-এ অনুমোদন প্রয়োজন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cal aprovar-ho a Configuració del Sistema > General > Ítems d’inici de sessió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje schválení v Nastavení systému > Obecné > Přihlášení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræver godkendelse i Systemindstillinger > Generelt > Loginemner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert eine Genehmigung in Systemeinstellungen > Allgemein > Anmeldeobjekte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτεί έγκριση στις Ρυθμίσεις συστήματος > Γενικά > Στοιχεία εισόδου."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires approval in System Settings > General > Login Items."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires approval in System Settings > General > Login Items."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires approval in System Settings > General > Login Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere aprobación en Ajustes del Sistema > General > Ítems de inicio."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere aprobación en Configuración del Sistema > General > Elementos de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatii hyväksynnän kohdassa Järjestelmäasetukset > Yleiset > Kirjautumiskohteet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À autoriser dans Réglages Système > Général > Ouverture."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "À autoriser dans Réglages système > Général > Ouverture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિસ્ટમ સેટિંગ્સ > સામાન્ય > લૉગ ઇન આઇટમમાં મંજૂરી જરૂરી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש אישור בהגדרות המערכת > כללי > פריטי התחברות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग > सामान्य > लॉगइन आइटम में अनुमति ज़रूरी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtijeva odobrenje u Postavkama sustava > Općenito > Stavke za prijavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jóváhagyás szükséges itt: Rendszerbeállítások > Általános > Indítóelemek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan persetujuan di Pengaturan Sistem > Umum > Item Masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede l’approvazione in Impostazioni di Sistema > Generali > Elementi login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」>「一般」>「ログイン項目」で許可が必要です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳು > ಸಾಮಾನ್ಯ > ಲಾಗಿನ್ ಐಟಂಗಳು ಇಲ್ಲಿ ಅನುಮೋದನೆ ಅಗತ್ಯವಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 일반 > 로그인 항목에서 승인이 필요합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റം ക്രമീകരണം > പൊതുവായവ > ലോഗിൻ ഇനങ്ങൾ എന്നതിൽ അംഗീകാരം ആവശ്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज > सामान्य > लॉग इन आयटम मध्ये मंजुरी आवश्यक आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan kelulusan dalam Seting Sistem > Umum > Item Log Masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krever godkjenning i Systeminnstillinger > Generelt > Påloggingsobjekter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist goedkeuring in Systeeminstellingen > Algemeen > Inloggen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସିଷ୍ଟମ ସେଟିଂସ > ସାଧାରଣ > ଲଗଇନ ଆଇଟମରେ ଅନୁମୋଦନ ଆବଶ୍ୟକ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ > ਆਮ > ਲੌਗ-ਇਨ ਆਈਟਮਾਂ ਵਿੱਚ ਮਨਜ਼ੂਰੀ ਲੋੜੀਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga zgody w Ustawieniach systemowych > Ogólne > Logowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer aprovação em Ajustes do Sistema > Geral > Itens de Início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer aprovação em Definições do Sistema > Geral > Início de sessão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesită aprobare în Configurări sistem > General > Lansare la login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение: Системные настройки > Основные > Объекты входа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje schválenie v Systémových nastaveniach > Všeobecné > Prihlásenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahteva odobritev v Nastavitvah sistema > Splošno > Elementi prijave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver godkännande i Systeminställningar > Allmänt > Startobjekt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிஸ்டம் அமைப்புகள் > பொது > உள்நுழைவு உருப்படிகள் என்பதில் அனுமதி தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ సెట్టింగ్‌లు > సాధారణం > లాగిన్ ఐటెమ్‌లు లో ఆమోదం అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องได้รับอนุมัติใน การตั้งค่าระบบ > ทั่วไป > รายการเข้าสู่ระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Genel > Oturum Açma Öğeleri bölümünde onay gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен дозвіл: Системні параметри > Загальні > Автозапуск."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم سیٹنگز > عمومی > لاگ ان آئٹمز میں منظوری درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần được chấp thuận trong Cài đặt hệ thống > Cài đặt chung > Mục đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在“系统设置”>“通用”>“登录项”中批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在「系統設定」>「一般」>「登入項目」中核准。"
          }
        }
      }
    },
