    "On for %@ without a restart: restarting can free memory.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل منذ %@ دون إعادة تشغيل: إعادة التشغيل قد تحرر الذاكرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিস্টার্ট ছাড়াই %@ ধরে চালু আছে: রিস্টার্ট করলে মেমরি খালি হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encès des de fa %@ sense reiniciar: reiniciar pot alliberar memòria."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží bez restartu už %@: restart může uvolnit paměť."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tændt i %@ uden genstart: en genstart kan frigøre hukommelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit %@ ohne Neustart eingeschaltet: Ein Neustart kann Arbeitsspeicher freigeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε λειτουργία εδώ και %@ χωρίς επανεκκίνηση: η επανεκκίνηση μπορεί να ελευθερώσει μνήμη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "On for %@ without a restart: restarting can free memory."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "On for %@ without a restart: restarting can free memory."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On for %@ without a restart: restarting can free memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
