          "stringUnit": {
            "state": "translated",
            "value": "macOS ஆப்களுக்கு வெப்ப நிலையைத் தருகிறது, வெப்பநிலையை அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS యాప్‌లకు వేడి స్థాయిని ఇస్తుంది, ఉష్ణోగ్రతను కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS แจ้งระดับความร้อนให้แอปทราบ ไม่ใช่อุณหภูมิ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS uygulamalara sıcaklığı değil, ısınma düzeyini bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS повідомляє програмам рівень нагріву, а не температуру."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ایپس کو حرارت کی سطح بتاتا ہے، درجہ حرارت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS cho ứng dụng biết mức nhiệt, không phải nhiệt độ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 向 App 提供的是发热程度，而不是温度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 向 App 提供的是發熱程度，而不是溫度。"
          }
        }
      }
    },
