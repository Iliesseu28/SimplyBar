    "Used, free and purgeable space on every disk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المساحة المستخدمة والمتاحة والقابلة للتنظيف على كل قرص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ডিস্কে ব্যবহৃত, খালি ও মুছে ফেলা যায় এমন জায়গা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Espai utilitzat, lliure i per depurar a cada disc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Využité, volné a vyprázdnitelné místo na každém disku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugt, ledig og sletbar plads på hver disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegter, freier und löschbarer Speicherplatz auf allen Festplatten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χώρος σε χρήση, ελεύθερος και εκκαθαρίσιμος σε κάθε δίσκο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Used, free and purgeable space on every disk."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Used, free and purgeable space on every disk."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Used, free and purgeable space on every disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio usado, libre y purgable en cada disco."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio usado, libre y purgable en cada disco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytetty, vapaa ja vapautettavissa oleva tila jokaisella levyllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace utilisé, libre et purgeable sur chaque disque."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace utilisé, libre et purgeable sur chaque disque."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ડિસ્ક પર વપરાયેલી, ખાલી અને પર્જ કરી શકાય તેવી જગ્યા."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שטח בשימוש, פנוי וניתן למחיקה בכל דיסק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर डिस्क पर उपयोग की गई, ख़ाली और पर्ज करने योग्य जगह।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zauzeti, slobodni i prostor za čišćenje na svakom disku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Foglalt, szabad és kiüríthető terület minden lemezen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang terpakai, kosong, dan dapat dihapus di setiap disk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio utilizzato, libero e cancellabile su ogni disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ディスクの使用済み、空き、パージ可能な領域。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಡಿಸ್ಕ್‌ನಲ್ಲಿ ಬಳಸಿದ, ಖಾಲಿ ಮತ್ತು ತೆಗೆದುಹಾಕಬಹುದಾದ ಸ್ಥಳ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 디스크의 사용된 공간, 사용 가능한 공간 및 제거 가능한 공간."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ഡിസ്കിലെയും ഉപയോഗിച്ചതും ഒഴിവുള്ളതും നീക്കം ചെയ്യാവുന്നതുമായ സ്ഥലം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक डिस्कवरील वापरलेली, रिकामी आणि पर्ज करण्यायोग्य जागा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang digunakan, kosong dan boleh disingkirkan pada setiap cakera."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukt, ledig og frigjørbar plass på hver disk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikte, vrije en wisbare ruimte op elke schijf."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଡିସ୍କରେ ବ୍ୟବହୃତ, ଖାଲି ଏବଂ ସଫା କରାଯାଇପାରୁଥିବା ସ୍ଥାନ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਡਿਸਕ ’ਤੇ ਵਰਤੀ ਗਈ, ਖਾਲੀ ਅਤੇ ਸਾਫ਼ ਕੀਤੀ ਜਾ ਸਕਣ ਵਾਲੀ ਥਾਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajęte, wolne i możliwe do usunięcia miejsce na każdym dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço usado, livre e purgável em cada disco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço utilizado, livre e purgável em cada disco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul folosit, liber și epurabil de pe fiecare disc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занятое, свободное и очищаемое место на каждом диске."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Využité, voľné a uvoľniteľné miesto na každom disku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasedeni, prosti in izbrisljivi prostor na vsakem disku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använt, ledigt och rensningsbart utrymme på varje skiva."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு டிஸ்க்கிலும் பயன்படுத்தப்பட்ட, காலியான மற்றும் அழிக்கக்கூடிய இடம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి డిస్క్‌లో ఉపయోగించిన, ఖాళీ మరియు తొలగించదగిన స్థలం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ที่ใช้แล้ว ว่าง และล้างได้ในทุกดิสก์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her diskteki kullanılan, boş ve silinebilir alan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зайняте, вільне й очищуване місце на кожному диску."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ڈسک پر استعمال شدہ، خالی اور قابل صفائی جگہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung lượng đã dùng, còn trống và có thể thanh lọc trên mỗi ổ đĩa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个磁盘上已使用、可用和可清除的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個磁碟上已使用、可用和可清除的空間。"
          }
        }
      }
    },
