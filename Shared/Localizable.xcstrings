    "Keeps this Mac awake, on or off in one click.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع جهاز Mac هذا من السكون، تشغيل أو إيقاف بنقرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac জাগিয়ে রাখে, এক ক্লিকে চালু বা বন্ধ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Manté aquest Mac actiu, s'activa o es desactiva amb un clic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabraňuje uspání Macu, zapnutí či vypnutí jedním kliknutím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder denne Mac vågen, slås til eller fra med ét klik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält diesen Mac wach, mit einem Klick ein- oder ausgeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποτρέπει τον ύπνο του Mac, ενεργοποίηση ή απενεργοποίηση με ένα κλικ."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this Mac awake, on or off in one click."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this Mac awake, on or off in one click."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this Mac awake, on or off in one click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene este Mac activo, se activa o desactiva con un clic."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene esta Mac activa, se activa o desactiva con un clic."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitää tämän Macin hereillä, päälle tai pois yhdellä osoituksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la mise en veille, à activer ou couper d'un clic."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la mise en veille, à activer ou couper d'un clic."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Macને જાગૃત રાખે છે, એક ક્લિકમાં ચાલુ કે બંધ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונע מה-Mac להיכנס למצב שינה, הפעלה או כיבוי בלחיצה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac को जागृत रखता है, एक क्लिक में चालू या बंद।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprječava mirovanje Maca, uključuje se ili isključuje jednim klikom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébren tartja a Macet, egy kattintással be- vagy kikapcsolható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga Mac ini tetap terjaga, nyalakan atau matikan dengan satu klik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene attivo questo Mac, si attiva o disattiva con un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのスリープを防ぎます。ワンクリックでオン/オフ。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Mac ಅನ್ನು ಎಚ್ಚರವಾಗಿಡುತ್ತದೆ, ಒಂದೇ ಕ್ಲಿಕ್‌ನಲ್ಲಿ ಆನ್ ಅಥವಾ ಆಫ್."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 잠자기를 방지하며, 클릭 한 번으로 켜거나 끕니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Mac സ്ലീപ്പ് ആകുന്നത് തടയുന്നു, ഒറ്റ ക്ലിക്കിൽ ഓണോ ഓഫോ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा Mac जागा ठेवतो, एका क्लिकमध्ये चालू किंवा बंद."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memastikan Mac ini kekal berjaga, hidupkan atau matikan dengan satu klik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder denne Macen våken, slås på eller av med ett klikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt deze Mac wakker, met één klik aan of uit."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି Macକୁ ଜାଗ୍ରତ ରଖେ, ଗୋଟିଏ କ୍ଲିକରେ ଚାଲୁ କିମ୍ବା ବନ୍ଦ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Mac ਨੂੰ ਜਾਗਦਾ ਰੱਖਦਾ ਹੈ, ਇੱਕ ਕਲਿੱਕ ਨਾਲ ਚਾਲੂ ਜਾਂ ਬੰਦ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje usypianie Maca, włączanie i wyłączanie jednym kliknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém este Mac ativo, ativado ou desativado com um clique."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém este Mac ativo, ativado ou desativado com um clique."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține acest Mac activ, pornit sau oprit dintr-un clic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт Mac засыпать, включается и выключается одним нажатием."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabraňuje uspaniu Macu, zapína sa a vypína jedným kliknutím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preprečuje mirovanje Maca, vklop ali izklop z enim klikom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håller datorn vaken, slå på eller av med ett klick."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac-ஐ விழிப்புடன் வைக்கிறது, ஒரே கிளிக்கில் ஆன் அல்லது ஆஃப்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Mac ను మేల్కొని ఉంచుతుంది, ఒక్క క్లిక్‌తో ఆన్ లేదా ఆఫ్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้องกันไม่ให้ Mac เครื่องนี้พักเครื่อง เปิดหรือปิดได้ในคลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'i uyanık tutar, tek tıklamayla açılır veya kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дає Mac засинати, вмикається й вимикається одним натисканням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac کو جاگتا رکھتا ہے، ایک کلک میں آن یا آف۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ máy Mac này luôn thức, bật hoặc tắt chỉ bằng một cú nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止这台 Mac 进入睡眠，一键打开或关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防止這台 Mac 進入睡眠，一鍵開啟或關閉。"
          }
        }
      }
    },
