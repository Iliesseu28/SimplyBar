            "value": "Şunlara da göz atmakta fayda var: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Варто також перевірити: %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بھی چیک کریں: %@۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũng nên kiểm tra: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另外建议检查：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另外建議檢查：%@。"
          }
        }
      }
    },
    "An alert comes back only once things are back to normal, and at most once an hour.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعود التنبيه إلا بعد عودة الأمور إلى طبيعتها، ومرة واحدة في الساعة على الأكثر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব কিছু স্বাভাবিক হওয়ার পরেই একটি সতর্কতা আবার আসে, এবং ঘণ্টায় সর্বোচ্চ একবার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una alerta només torna quan tot ha tornat a la normalitat, i com a màxim un cop per hora."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění se vrátí až po návratu do normálu, a nejvýš jednou za hodinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En advarsel kommer først igen, når alt er normalt igen, og højst én gang i timen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Warnung kommt erst wieder, wenn alles wieder normal ist, und höchstens einmal pro Stunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ειδοποίηση επανέρχεται μόνο αφού όλα επιστρέψουν στο κανονικό, και το πολύ μία φορά την ώρα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "An alert comes back only once things are back to normal, and at most once an hour."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "An alert comes back only once things are back to normal, and at most once an hour."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An alert comes back only once things are back to normal, and at most once an hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una alerta solo vuelve cuando todo ha vuelto a la normalidad, y como máximo una vez por hora."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una alerta solo vuelve cuando todo ha vuelto a la normalidad, y como máximo una vez por hora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytys tulee uudelleen vasta, kun tilanne on palannut normaaliksi, ja enintään kerran tunnissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte ne revient qu'après un retour à la normale, et au plus une fois par heure."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte ne revient qu'après un retour à la normale, et au plus une fois par heure."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધું સામાન્ય થયા પછી જ ચેતવણી ફરી આવે છે, અને કલાકમાં વધુમાં વધુ એક વાર."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראה חוזרת רק אחרי שהמצב חוזר לקדמותו, ולכל היותר פעם בשעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अलर्ट तभी दोबारा आता है जब सब कुछ सामान्य हो जाए, और घंटे में ज़्यादा से ज़्यादा एक बार।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorenje se vraća tek nakon povratka u normalu, i najviše jednom na sat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy riasztás csak akkor jön újra, ha minden visszaállt a normális állapotba, és legfeljebb óránként egyszer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan hanya muncul lagi setelah keadaan kembali normal, dan paling banyak sekali per jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avviso torna solo dopo il ritorno alla normalità, e al massimo una volta all'ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラートは状態が正常に戻ってからのみ再び通知され、1時間に1回までです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲವೂ ಸಾಮಾನ್ಯ ಸ್ಥಿತಿಗೆ ಮರಳಿದ ನಂತರವೇ ಎಚ್ಚರಿಕೆ ಮತ್ತೆ ಬರುತ್ತದೆ, ಮತ್ತು ಗಂಟೆಗೆ ಗರಿಷ್ಠ ಒಮ್ಮೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경고는 상태가 정상으로 돌아온 뒤에만 다시 표시되며, 최대 1시간에 한 번입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാം സാധാരണ നിലയിലായ ശേഷം മാത്രമേ ഒരു മുന്നറിയിപ്പ് വീണ്ടും വരൂ, മണിക്കൂറിൽ പരമാവധി ഒരിക്കൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इशारा सर्व काही सामान्य झाल्यावरच पुन्हा येतो, आणि तासाला जास्तीत जास्त एकदा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaran hanya muncul semula selepas keadaan kembali normal, dan paling banyak sekali sejam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En advarsel kommer først tilbake når alt er normalt igjen, og høyst én gang i timen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een waarschuwing komt pas terug als alles weer normaal is, en hooguit één keer per uur."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବୁ ସାଧାରଣ ହେବା ପରେ ହିଁ ସତର୍କତା ପୁଣି ଆସେ, ଏବଂ ଘଣ୍ଟାକୁ ସର୍ବାଧିକ ଥରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਕੁਝ ਆਮ ਵਾਂਗ ਹੋਣ ਤੋਂ ਬਾਅਦ ਹੀ ਚਿਤਾਵਨੀ ਦੁਬਾਰਾ ਆਉਂਦੀ ਹੈ, ਅਤੇ ਘੰਟੇ ਵਿੱਚ ਵੱਧ ਤੋਂ ਵੱਧ ਇੱਕ ਵਾਰ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert wraca dopiero po powrocie do normy i nie częściej niż raz na godzinę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um alerta só volta depois que tudo voltar ao normal, e no máximo uma vez por hora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um alerta só volta depois de tudo voltar ao normal, e no máximo uma vez por hora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O alertă revine abia după revenirea la normal și cel mult o dată pe oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оповещение повторяется только после возврата к норме и не чаще раза в час."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenie sa vráti až po návrate do normálu, a najviac raz za hodinu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opozorilo se vrne šele po vrnitvi v normalno stanje in največ enkrat na uro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En varning kommer tillbaka först när allt är normalt igen, och högst en gång i timmen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லாம் இயல்பு நிலைக்குத் திரும்பிய பிறகுதான் எச்சரிக்கை மீண்டும் வரும், மணிக்கு அதிகபட்சம் ஒருமுறை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతా సాధారణ స్థితికి వచ్చిన తర్వాతే హెచ్చరిక మళ్లీ వస్తుంది, గంటకు గరిష్ఠంగా ఒకసారి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำเตือนจะกลับมาอีกครั้งเมื่อทุกอย่างกลับสู่ปกติแล้วเท่านั้น และไม่เกินชั่วโมงละครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uyarı ancak her şey normale döndükten sonra ve en fazla saatte bir kez yeniden gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередження повторюється лише після повернення до норми і не частіше ніж раз на годину."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انتباہ صرف معمول پر واپسی کے بعد دوبارہ آتا ہے، اور زیادہ سے زیادہ ایک گھنٹے میں ایک بار۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cảnh báo chỉ xuất hiện lại sau khi mọi thứ trở lại bình thường, và tối đa một lần mỗi giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒只会在恢复正常后再次出现，且每小时最多一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒只會在恢復正常後再次出現，且每小時最多一次。"
          }
        }
      }
    },
