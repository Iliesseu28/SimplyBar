    "The icon turns yellow, orange or red as the Mac heats up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحول الأيقونة إلى الأصفر أو البرتقالي أو الأحمر كلما ارتفعت حرارة Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac গরম হলে আইকন হলুদ, কমলা বা লাল হয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La icona es torna groga, taronja o vermella a mesura que el Mac s’escalfa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona zežloutne, zoranžoví nebo zčervená, když se Mac zahřívá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolet bliver gult, orange eller rødt, når Mac'en bliver varm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol wird gelb, orange oder rot, wenn sich der Mac erwärmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το εικονίδιο γίνεται κίτρινο, πορτοκαλί ή κόκκινο καθώς ζεσταίνεται το Mac."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The icon turns yellow, orange or red as the Mac heats up."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The icon turns yellow, orange or red as the Mac heats up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The icon turns yellow, orange or red as the Mac heats up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono se vuelve amarillo, naranja o rojo a medida que el Mac se calienta."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El ícono se vuelve amarillo, naranja o rojo a medida que la Mac se calienta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvake muuttuu keltaiseksi, oranssiksi tai punaiseksi Macin lämmetessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône passe au jaune, à l'orange ou au rouge quand le Mac chauffe."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône passe au jaune, à l'orange ou au rouge quand le Mac chauffe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ગરમ થાય તેમ આઇકન પીળું, નારંગી કે લાલ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצלמית הופכת לצהובה, כתומה או אדומה ככל שה-Mac מתחמם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac के गर्म होने पर आइकन पीला, नारंगी या लाल हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona postaje žuta, narančasta ili crvena kako se Mac zagrijava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ikon sárgára, narancssárgára vagy pirosra vált, ahogy a Mac melegszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon berubah kuning, oranye, atau merah saat Mac memanas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icona diventa gialla, arancione o rossa man mano che il Mac si scalda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが熱くなるにつれて、アイコンが黄色、オレンジ、赤に変わります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ಬಿಸಿಯಾದಂತೆ ಐಕಾನ್ ಹಳದಿ, ಕಿತ್ತಳೆ ಅಥವಾ ಕೆಂಪು ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 뜨거워지면 아이콘이 노란색, 주황색 또는 빨간색으로 바뀝니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ചൂടാകുമ്പോൾ ഐക്കൺ മഞ്ഞ, ഓറഞ്ച് അല്ലെങ്കിൽ ചുവപ്പ് ആകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac गरम होताना आयकन पिवळा, नारिंगी किंवा लाल होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon bertukar kuning, oren atau merah apabila Mac semakin panas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolet blir gult, oransje eller rødt når Macen blir varm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het symbool wordt geel, oranje of rood naarmate de Mac warmer wordt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ଗରମ ହେବା ସହ ଆଇକନ ହଳଦିଆ, କମଳା କିମ୍ବା ନାଲି ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ਗਰਮ ਹੋਣ ਨਾਲ ਆਈਕਨ ਪੀਲਾ, ਸੰਤਰੀ ਜਾਂ ਲਾਲ ਹੋ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona zmienia kolor na żółty, pomarańczowy lub czerwony, gdy Mac się nagrzewa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone fica amarelo, laranja ou vermelho conforme o Mac esquenta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone fica amarelo, laranja ou vermelho à medida que o Mac aquece."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictograma devine galbenă, portocalie sau roșie pe măsură ce Mac-ul se încălzește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок становится жёлтым, оранжевым или красным по мере нагрева Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona zožltne, zoranžovie alebo sčervenie, keď sa Mac zahrieva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona postane rumena, oranžna ali rdeča, ko se Mac segreva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolen blir gul, orange eller röd när Macen blir varm."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac சூடாகும்போது ஐகான் மஞ்சள், ஆரஞ்சு அல்லது சிவப்பாக மாறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac వేడెక్కే కొద్దీ ఐకాన్ పసుపు, నారింజ లేదా ఎరుపు రంగులోకి మారుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนจะเปลี่ยนเป็นสีเหลือง สีส้ม หรือสีแดงเมื่อ Mac ร้อนขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ısındıkça simge sarı, turuncu veya kırmızı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок стає жовтим, помаранчевим або червоним, коли Mac нагрівається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac گرم ہونے پر آئیکن پیلا، نارنجی یا سرخ ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng chuyển sang vàng, cam hoặc đỏ khi máy Mac nóng lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随着 Mac 升温，图标会变为黄色、橙色或红色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨著 Mac 升溫，圖像會變成黃色、橘色或紅色。"
          }
        }
      }
    },
    "The network is busy: %@ received, %@ sent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشبكة مشغولة: %@ مستلمة، و%@ مرسلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্ক ব্যস্ত: %@ গৃহীত, %@ প্রেরিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La xarxa està molt ocupada: %@ rebuts, %@ enviats."
          }
        },
        "cs": {
