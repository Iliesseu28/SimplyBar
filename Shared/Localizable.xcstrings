    "Quit the apps you are not using, or restart the Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ التطبيقات التي لا تستخدمها، أو أعد تشغيل جهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে অ্যাপগুলি ব্যবহার করছেন না সেগুলি বন্ধ করুন, অথবা Mac রিস্টার্ট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca les apps que no facis servir o reinicia el Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončete aplikace, které nepoužíváte, nebo Mac restartujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslut de apps, du ikke bruger, eller genstart Mac'en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die Apps, die du nicht verwendest, oder starte den Mac neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλείστε τις εφαρμογές που δεν χρησιμοποιείτε ή επανεκκινήστε το Mac."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit the apps you are not using, or restart the Mac."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit the apps you are not using, or restart the Mac."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit the apps you are not using, or restart the Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra las apps que no estés usando o reinicia el Mac."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra las apps que no estés usando o reinicia la Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopeta apit, joita et käytä, tai käynnistä Mac uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez les apps que vous n'utilisez pas, ou redémarrez le Mac."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez les apps que vous n'utilisez pas, ou redémarrez le Mac."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઉપયોગ ન કરતા હો તે ઍપ્સ બંધ કરો અથવા Mac રીસ્ટાર્ટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צאו מהאפליקציות שאינכם משתמשים בהן, או הפעילו מחדש את ה-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन ऐप्स का आप उपयोग नहीं कर रहे, उन्हें बंद करें या Mac को रीस्टार्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvorite aplikacije koje ne koristite ili ponovno pokrenite Mac."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lépj ki a nem használt appokból, vagy indítsd újra a Macet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup app yang tidak Anda gunakan, atau mulai ulang Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi le app che non usi o riavvia il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用していないアプリを終了するか、Macを再起動してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಬಳಸದ ಆ್ಯಪ್‌ಗಳನ್ನು ಮುಚ್ಚಿ, ಅಥವಾ Mac ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않는 앱을 종료하거나 Mac을 재시동하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഉപയോഗിക്കാത്ത ആപ്പുകൾ അടയ്ക്കുക, അല്ലെങ്കിൽ Mac റീസ്റ്റാർട്ട് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही वापरत नसलेली ॲप्स बंद करा किंवा Mac रीस्टार्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup app yang tidak anda gunakan, atau mulakan semula Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutt appene du ikke bruker, eller start Macen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop de apps die je niet gebruikt of herstart de Mac."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ବ୍ୟବହାର କରୁନଥିବା ଆପ୍ସ ବନ୍ଦ କରନ୍ତୁ, କିମ୍ବା Mac ରିଷ୍ଟାର୍ଟ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਹੜੀਆਂ ਐਪਾਂ ਤੁਸੀਂ ਨਹੀਂ ਵਰਤ ਰਹੇ, ਉਹਨਾਂ ਨੂੰ ਬੰਦ ਕਰੋ ਜਾਂ Mac ਨੂੰ ਰੀਸਟਾਰਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij aplikacje, których nie używasz, albo uruchom ponownie Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre os apps que você não está usando ou reinicie o Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche as apps que não está a utilizar ou reinicie o Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închide aplicațiile pe care nu le folosești sau repornește Mac-ul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите приложения, которые не используете, или перезагрузите Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončite aplikácie, ktoré nepoužívate, alebo reštartujte Mac."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaprite aplikacije, ki jih ne uporabljate, ali znova zaženite Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluta appar du inte använder, eller starta om Macen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பயன்படுத்தாத ஆப்களை மூடவும் அல்லது Mac-ஐ மறுதொடக்கம் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఉపయోగించని యాప్‌లను మూసివేయండి లేదా Mac ని రీస్టార్ట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากแอปที่คุณไม่ได้ใช้ หรือเริ่มการทำงานของ Mac ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmadığınız uygulamalardan çıkın veya Mac'i yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрийте програми, якими не користуєтеся, або перезавантажте Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو ایپس آپ استعمال نہیں کر رہے انہیں بند کریں، یا Mac کو ری اسٹارٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thoát các ứng dụng bạn không dùng hoặc khởi động lại máy Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
