    "If a device is missing, disconnect it and connect it again while the list refreshes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان أحد الأجهزة مفقودًا، فافصله ثم أعد توصيله أثناء تحديث القائمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ডিভাইস না থাকলে, তালিকা রিফ্রেশ হওয়ার সময় সেটি ডিসকানেক্ট করে আবার কানেক্ট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si falta un dispositiu, desconnecta’l i torna’l a connectar mentre la llista s’actualitza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud některé zařízení chybí, odpojte ho a znovu připojte, zatímco se seznam obnovuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en enhed mangler, så afbryd forbindelsen til den, og forbind den igen, mens listen opdateres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt ein Gerät, trenne es und verbinde es erneut, während die Liste aktualisiert wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν λείπει μια συσκευή, αποσυνδέστε την και συνδέστε την ξανά ενώ ανανεώνεται η λίστα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If a device is missing, disconnect it and connect it again while the list refreshes."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If a device is missing, disconnect it and connect it again while the list refreshes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If a device is missing, disconnect it and connect it again while the list refreshes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si falta un dispositivo, desconéctalo y vuelve a conectarlo mientras se actualiza la lista."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si falta un dispositivo, desconéctalo y vuelve a conectarlo mientras se actualiza la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos laite puuttuu, katkaise sen yhteys ja yhdistä se uudelleen, kun luetteloa päivitetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un appareil manque, déconnectez-le puis reconnectez-le pendant que la liste se met à jour."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un appareil manque, déconnectez-le puis reconnectez-le pendant que la liste se met à jour."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો કોઈ ડિવાઇસ ખૂટતું હોય, તો સૂચિ રિફ્રેશ થતી હોય ત્યારે તેને ડિસ્કનેક્ટ કરીને ફરી કનેક્ટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם מכשיר חסר, נתקו אותו וחברו אותו מחדש בזמן שהרשימה מתרעננת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर कोई डिवाइस नहीं दिख रहा है, तो सूची रीफ़्रेश होते समय उसे डिस्कनेक्ट करके फिर से कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako neki uređaj nedostaje, odspojite ga i ponovno spojite dok se popis osvježava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy eszköz hiányzik, válaszd le, majd csatlakoztasd újra, amíg a lista frissül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ada perangkat yang tidak muncul, putuskan lalu sambungkan kembali saat daftar diperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se manca un dispositivo, scollegalo e ricollegalo mentre l’elenco si aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが表示されない場合は、リストの更新中にいったん接続を解除してから再接続してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದಾದರೂ ಸಾಧನ ಕಾಣೆಯಾಗಿದ್ದರೆ, ಪಟ್ಟಿ ರಿಫ್ರೆಶ್ ಆಗುತ್ತಿರುವಾಗ ಅದರ ಸಂಪರ್ಕ ಕಡಿತಗೊಳಿಸಿ ಮತ್ತೆ ಸಂಪರ್ಕಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 보이지 않으면 목록이 새로 고쳐지는 동안 연결을 해제했다가 다시 연결하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഉപകരണം കാണുന്നില്ലെങ്കിൽ, ലിസ്റ്റ് പുതുക്കുമ്പോൾ അത് വിച്ഛേദിച്ച് വീണ്ടും കണക്റ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखादे डिव्हाइस दिसत नसल्यास, यादी रीफ्रेश होत असताना ते डिस्कनेक्ट करून पुन्हा कनेक्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika peranti tiada, putuskan sambungannya dan sambungkan semula semasa senarai disegarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en enhet mangler, kobler du den fra og til igjen mens listen oppdateres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontbreekt er een apparaat? Koppel het los en maak opnieuw verbinding terwijl de lijst wordt vernieuwd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯଦି କୌଣସି ଡିଭାଇସ ନାହିଁ, ତାଲିକା ରିଫ୍ରେସ ହେବା ସମୟରେ ଏହାକୁ ବିଚ୍ଛିନ୍ନ କରି ପୁଣି ସଂଯୋଗ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਕੋਈ ਡੀਵਾਈਸ ਗੁੰਮ ਹੈ, ਤਾਂ ਸੂਚੀ ਰਿਫ੍ਰੈਸ਼ ਹੋਣ ਦੌਰਾਨ ਉਸਨੂੰ ਡਿਸਕਨੈਕਟ ਕਰਕੇ ਦੁਬਾਰਾ ਕਨੈਕਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli brakuje urządzenia, rozłącz je i połącz ponownie podczas odświeżania listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um dispositivo estiver faltando, desconecte-o e conecte-o novamente enquanto a lista é atualizada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se faltar um dispositivo, desligue-o e volte a ligá-lo enquanto a lista é atualizada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă lipsește un dispozitiv, deconectează-l și conectează-l din nou în timp ce lista se actualizează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если устройства нет в списке, отключите его и подключите снова, пока список обновляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak niektoré zariadenie chýba, odpojte ho a znova pripojte, kým sa zoznam obnovuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če naprava manjka, jo odklopite in znova povežite, medtem ko se seznam osvežuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om en enhet saknas kopplar du från den och ansluter den igen medan listan uppdateras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதேனும் சாதனம் காணவில்லை என்றால், பட்டியல் புதுப்பிக்கப்படும்போது அதைத் துண்டித்து மீண்டும் இணைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదైనా పరికరం కనిపించకపోతే, జాబితా రిఫ్రెష్ అవుతున్నప్పుడు దాన్ని డిస్‌కనెక్ట్ చేసి మళ్లీ కనెక్ట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่พบอุปกรณ์ ให้ตัดการเชื่อมต่อแล้วเชื่อมต่อใหม่ขณะที่รายการกำลังรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aygıt eksikse liste yenilenirken bağlantısını kesip yeniden bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо пристрою немає у списку, відʼєднайте його й підʼєднайте знову, поки список оновлюється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کوئی آلہ غائب ہو تو فہرست کے ریفریش ہونے کے دوران اسے منقطع کر کے دوبارہ منسلک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thiếu thiết bị, hãy ngắt kết nối rồi kết nối lại trong khi danh sách đang làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果缺少某个设备，请在列表刷新时断开该设备并重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果缺少某個裝置，請在列表重新整理時中斷該裝置的連線，然後重新連接。"
          }
        }
      }
    },
