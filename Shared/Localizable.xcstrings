    "Save your work, quit heavy apps and let the Mac cool down.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ عملك، وأغلق التطبيقات الثقيلة، واترك جهاز Mac ليبرد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কাজ সংরক্ষণ করুন, ভারী অ্যাপ বন্ধ করুন এবং Mac-কে ঠান্ডা হতে দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa la feina, tanca les apps pesades i deixa que el Mac es refredi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si práci, ukončete náročné aplikace a nechte Mac vychladnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem dit arbejde, afslut tunge apps, og lad Mac'en køle af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere deine Arbeit, beende rechenintensive Apps und lass den Mac abkühlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε την εργασία σας, κλείστε τις απαιτητικές εφαρμογές και αφήστε το Mac να κρυώσει."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your work, quit heavy apps and let the Mac cool down."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your work, quit heavy apps and let the Mac cool down."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your work, quit heavy apps and let the Mac cool down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu trabajo, cierra las apps pesadas y deja que el Mac se enfríe."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu trabajo, cierra las apps pesadas y deja que la Mac se enfríe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna työsi, sulje raskaat apit ja anna Macin jäähtyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre travail, quittez les apps gourmandes et laissez le Mac refroidir."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre travail, quittez les apps gourmandes et laissez le Mac refroidir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું કામ સેવ કરો, ભારે ઍપ્સ બંધ કરો અને Macને ઠંડું થવા દો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו את העבודה, סגרו אפליקציות כבדות ותנו ל-Mac להתקרר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना काम सहेजें, भारी ऐप्स बंद करें और Mac को ठंडा होने दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremite rad, zatvorite zahtjevne aplikacije i pustite da se Mac ohladi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd a munkádat, lépj ki a nagy terhelésű appokból, és hagyd lehűlni a Macet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan pekerjaan Anda, tutup app yang berat, dan biarkan Mac mendingin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il lavoro, chiudi le app pesanti e lascia raffreddare il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業内容を保存し、負荷の高いアプリを終了して、Macを冷ましてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಉಳಿಸಿ, ಭಾರೀ ಆ್ಯಪ್‌ಗಳನ್ನು ಮುಚ್ಚಿ ಮತ್ತು Mac ತಣ್ಣಗಾಗಲು ಬಿಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 저장하고 무거운 앱을 종료한 다음 Mac을 식히십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ജോലി സേവ് ചെയ്യുക, ഭാരമേറിയ ആപ്പുകൾ അടയ്ക്കുക, Mac തണുക്കാൻ അനുവദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे काम सेव्ह करा, जड ॲप्स बंद करा आणि Mac ला थंड होऊ द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan kerja anda, tutup app berat dan biarkan Mac sejuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre arbeidet, avslutt tunge apper, og la Macen kjøle seg ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar je werk, stop zware apps en laat de Mac afkoelen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ କାମ ସେଭ କରନ୍ତୁ, ଭାରୀ ଆପ୍ସ ବନ୍ଦ କରନ୍ତୁ ଏବଂ Macକୁ ଥଣ୍ଡା ହେବାକୁ ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣਾ ਕੰਮ ਸੇਵ ਕਰੋ, ਭਾਰੀ ਐਪਾਂ ਬੰਦ ਕਰੋ ਅਤੇ Mac ਨੂੰ ਠੰਢਾ ਹੋਣ ਦਿਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz pracę, zamknij wymagające aplikacje i pozwól Macowi ostygnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve seu trabalho, feche os apps pesados e deixe o Mac esfriar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o seu trabalho, feche as apps pesadas e deixe o Mac arrefecer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează-ți lucrul, închide aplicațiile solicitante și lasă Mac-ul să se răcească."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните работу, завершите ресурсоёмкие приложения и дайте Mac остыть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si prácu, ukončite náročné aplikácie a nechajte Mac vychladnúť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranite delo, zaprite zahtevne aplikacije in pustite, da se Mac ohladi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara ditt arbete, avsluta tunga appar och låt Macen svalna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வேலையைச் சேமித்து, கனமான ஆப்களை மூடி, Mac ஐ குளிர விடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పనిని సేవ్ చేసి, భారీ యాప్‌లను మూసివేసి, Mac ని చల్లబడనివ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกงานของคุณ ปิดแอปที่ใช้ทรัพยากรมาก และปล่อยให้ Mac เย็นลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışmanızı kaydedin, ağır uygulamalardan çıkın ve Mac'in soğumasını bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть роботу, закрийте ресурсомісткі програми й дайте Mac охолонути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا کام محفوظ کریں، بھاری ایپس بند کریں اور Mac کو ٹھنڈا ہونے دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy lưu công việc, thoát các ứng dụng nặng và để máy Mac nguội đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请存储你的工作，退出占用资源多的 App，让 Mac 降温。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請儲存你的工作，結束耗用大量資源的 App，讓 Mac 降溫。"
          }
        }
      }
    },
