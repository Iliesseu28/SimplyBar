        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence se prépare. Réessayez dans quelques minutes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence તૈયાર થઈ રહ્યું છે. થોડી મિનિટોમાં ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence מתכונן. נסו שוב בעוד כמה דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence तैयार हो रहा है। कुछ मिनट बाद फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence se priprema. Pokušajte ponovno za nekoliko minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence előkészítése folyamatban. Próbáld újra néhány perc múlva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sedang bersiap. Coba lagi dalam beberapa menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence si sta preparando. Riprova tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceの準備中です。数分後にもう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ಸಿದ್ಧವಾಗುತ್ತಿದೆ. ಕೆಲವು ನಿಮಿಷಗಳ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 준비하는 중입니다. 몇 분 후에 다시 시도하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence തയ്യാറാകുന്നു. കുറച്ച് മിനിറ്റുകൾക്ക് ശേഷം വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence तयार होत आहे. काही मिनिटांनी पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sedang bersedia. Cuba lagi dalam beberapa minit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence gjør seg klar. Prøv igjen om noen minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wordt voorbereid. Probeer het over een paar minuten opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ପ୍ରସ୍ତୁତ ହେଉଛି। କିଛି ମିନିଟ ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ਤਿਆਰ ਹੋ ਰਿਹਾ ਹੈ। ਕੁਝ ਮਿੰਟਾਂ ਬਾਅਦ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence się przygotowuje. Spróbuj ponownie za kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está sendo preparada. Tente novamente em alguns minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está a ser preparada. Tente novamente dentro de alguns minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence se pregătește. Încearcă din nou peste câteva minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence готовится к работе. Повторите попытку через несколько минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sa pripravuje. Skúste to znova o niekoľko minút."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence se pripravlja. Poskusite znova čez nekaj minut."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence förbereds. Försök igen om några minuter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence தயாராகிறது. சில நிமிடங்களில் மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence సిద్ధమవుతోంది. కొన్ని నిమిషాల తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence กำลังเตรียมพร้อม ลองอีกครั้งในอีกไม่กี่นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence hazırlanıyor. Birkaç dakika sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence готується до роботи. Спробуйте ще раз за кілька хвилин."
          }
