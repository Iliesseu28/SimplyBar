    "Apple Intelligence can't answer that. Try another question about your Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ Apple Intelligence الإجابة عن ذلك. جرّب سؤالًا آخر عن جهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence এর উত্তর দিতে পারে না। আপনার Mac সম্পর্কে অন্য কোনো প্রশ্ন করে দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no pot respondre això. Prova una altra pregunta sobre el teu Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence na to nedokáže odpovědět. Zkuste jinou otázku o svém Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kan ikke svare på det. Prøv et andet spørgsmål om din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kann das nicht beantworten. Versuche es mit einer anderen Frage zu deinem Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Apple Intelligence δεν μπορεί να απαντήσει σε αυτό. Δοκιμάστε μια άλλη ερώτηση για το Mac σας."
          }
        },
        "en-AU": {
          "stringUnit": {
