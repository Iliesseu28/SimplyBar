    "Heat level of this Mac, and its battery on a laptop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى حرارة جهاز Mac هذا، وبطاريته في الكمبيوتر المحمول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এর তাপের মাত্রা, এবং ল্যাপটপে এর ব্যাটারি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivell de calor d’aquest Mac i, en un portàtil, la seva bateria."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úroveň zahřátí tohoto Macu a u notebooku i jeho baterie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmeniveauet for denne Mac og, på en bærbar, dens batteri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wärmestufe dieses Mac und auf einem Laptop seine Batterie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίπεδο θέρμανσης αυτού του Mac και, σε φορητό, η μπαταρία του."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat level of this Mac, and its battery on a laptop."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat level of this Mac, and its battery on a laptop."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat level of this Mac, and its battery on a laptop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel de calor de este Mac y, en un portátil, su batería."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel de calor de esta Mac y, en una laptop, su batería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän Macin lämpötaso ja kannettavassa sen akku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau de chauffe de ce Mac, et sa batterie sur un portable."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau de chauffe de ce Mac, et sa batterie sur un portable."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Macનું ગરમીનું સ્તર, અને લૅપટૉપ પર તેની બૅટરી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רמת החום של ה-Mac הזה, ובמחשב נייד גם הסוללה שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac का गर्मी स्तर, और लैपटॉप पर उसकी बैटरी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razina zagrijanosti ovog Maca i, na prijenosnom računalu, njegova baterija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac melegedési szintje, laptopon pedig az akkumulátora."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkat panas Mac ini, dan baterainya pada laptop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Livello di calore di questo Mac e, su un portatile, la sua batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの発熱レベルと、ノートブックの場合はバッテリー。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Mac ನ ಬಿಸಿಯ ಮಟ್ಟ, ಮತ್ತು ಲ್ಯಾಪ್‌ಟಾಪ್‌ನಲ್ಲಿ ಅದರ ಬ್ಯಾಟರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 발열 수준과, 노트북에서는 배터리."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Mac-ന്റെ ചൂടിന്റെ നില, ലാപ്‌ടോപ്പിൽ അതിന്റെ ബാറ്ററിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac ची उष्णता पातळी, आणि लॅपटॉपवर त्याची बॅटरी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahap panas Mac ini, dan baterinya pada komputer riba."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmenivået til denne Macen og, på en bærbar, batteriet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmteniveau van deze Mac en, op een laptop, de batterij."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି Macର ଗରମ ସ୍ତର, ଏବଂ ଲାପଟପରେ ଏହାର ବ୍ୟାଟେରୀ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Mac ਦਾ ਗਰਮੀ ਪੱਧਰ, ਅਤੇ ਲੈਪਟਾਪ ’ਤੇ ਇਸਦੀ ਬੈਟਰੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziom nagrzania tego Maca i, w laptopie, jego bateria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nível de calor deste Mac e, em um notebook, a bateria dele."
          }
