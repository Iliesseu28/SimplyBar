          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે કોઈ ડિવાઇસ %@ કે તેથી ઓછી થાય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאשר מכשיר יורד ל-%@ או פחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई डिवाइस %@ या उससे कम पर आ जाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad uređaj padne na %@ ili manje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy eszköz töltöttsége %@ vagy az alá csökken."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat perangkat turun ke %@ atau kurang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un dispositivo scende al %@ o meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの残量が%@以下になったとき。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಧನವು %@ ಅಥವಾ ಕಡಿಮೆಗೆ ಇಳಿದಾಗ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 %@ 이하로 떨어질 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഉപകരണം %@ അല്ലെങ്കിൽ അതിൽ താഴെ എത്തുമ്പോൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जेव्हा एखादे डिव्हाइस %@ किंवा कमी होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila peranti jatuh ke %@ atau kurang."
          }
