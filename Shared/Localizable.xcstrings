    "Apple Intelligence is getting ready. Try again in a few minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تجهيز Apple Intelligence. أعد المحاولة بعد بضع دقائق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence প্রস্তুত হচ্ছে। কয়েক মিনিট পরে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence s’està preparant. Torna-ho a provar d’aquí a uns minuts."
