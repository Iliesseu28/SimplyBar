            "state": "translated",
            "value": "Apple Intelligence no puede responder eso. Prueba con otra pregunta sobre tu Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ei voi vastata tähän. Kokeile toista kysymystä Macistasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ne peut pas répondre à cela. Essayez une autre question sur votre Mac."
          }
        },
        "fr-CA": {
