    "SimplyBar collects no data. Every measurement stays on this Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع SimplyBar أي بيانات. تبقى جميع القياسات على جهاز Mac هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar কোনো ডেটা সংগ্রহ করে না। প্রতিটি পরিমাপ এই Mac-এই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar no recull cap dada. Totes les mesures es queden en aquest Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar neshromažďuje žádná data. Všechna měření zůstávají v tomto Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar indsamler ingen data. Alle målinger forbliver på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar erfasst keine Daten. Alle Messungen bleiben auf diesem Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το SimplyBar δεν συλλέγει κανένα δεδομένο. Κάθε μέτρηση μένει σε αυτό το Mac."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar collects no data. Every measurement stays on this Mac."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar collects no data. Every measurement stays on this Mac."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar collects no data. Every measurement stays on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar no recopila ningún dato. Todas las mediciones se quedan en este Mac."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar no recopila ningún dato. Todas las mediciones se quedan en esta Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ei kerää mitään tietoja. Kaikki mittaukset pysyvät tällä Macilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ne collecte aucune donnée. Chaque mesure reste sur ce Mac."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ne collecte aucune donnée. Chaque mesure reste sur ce Mac."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar કોઈ ડેટા એકત્ર કરતું નથી. દરેક માપ આ જ Mac પર રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar לא אוסף שום נתונים. כל המדידות נשארות ב-Mac הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar कोई डेटा एकत्र नहीं करता। हर माप इसी Mac पर रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ne prikuplja nikakve podatke. Sva mjerenja ostaju na ovom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SimplyBar semmilyen adatot nem gyűjt. Minden mérés ezen a Macen marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar tidak mengumpulkan data apa pun. Semua pengukuran tetap di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar non raccoglie alcun dato. Ogni misurazione resta su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBarはデータを一切収集しません。すべての計測はこのMac内で完結します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ಯಾವುದೇ ಡೇಟಾವನ್ನು ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ. ಪ್ರತಿಯೊಂದು ಅಳತೆಯೂ ಈ Mac ನಲ್ಲೇ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar는 어떠한 데이터도 수집하지 않습니다. 모든 측정값은 이 Mac에만 남습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ഒരു ഡാറ്റയും ശേഖരിക്കുന്നില്ല. എല്ലാ അളവുകളും ഈ Mac-ൽ തന്നെ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar कोणताही डेटा गोळा करत नाही. प्रत्येक मोजमाप याच Mac वर राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar tidak mengumpul sebarang data. Setiap pengukuran kekal pada Mac ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar samler ikke inn data. Alle målinger blir værende på denne Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar verzamelt geen gegevens. Elke meting blijft op deze Mac."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar କୌଣସି ଡାଟା ସଂଗ୍ରହ କରେ ନାହିଁ। ପ୍ରତ୍ୟେକ ମାପ ଏହି Mac ରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ਕੋਈ ਡਾਟਾ ਇਕੱਠਾ ਨਹੀਂ ਕਰਦਾ। ਹਰ ਮਾਪ ਇਸੇ Mac ’ਤੇ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar nie zbiera żadnych danych. Wszystkie pomiary pozostają na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SimplyBar não coleta nenhum dado. Todas as medições ficam neste Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O SimplyBar não recolhe quaisquer dados. Todas as medições ficam neste Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar nu colectează nicio dată. Toate măsurătorile rămân pe acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar не собирает никаких данных. Все измерения остаются на этом Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar nezbiera žiadne údaje. Všetky merania zostávajú v tomto Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ne zbira nobenih podatkov. Vse meritve ostanejo v tem Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar samlar inte in några data. Alla mätningar stannar på den här datorn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar எந்தத் தரவையும் சேகரிப்பதில்லை. ஒவ்வொரு அளவீடும் இந்த Mac இலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ఎలాంటి డేటాను సేకరించదు. ప్రతి కొలత ఈ Mac లోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar ไม่เก็บข้อมูลใดๆ การวัดทั้งหมดจะอยู่ใน Mac เครื่องนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar hiçbir veri toplamaz. Tüm ölçümler bu Mac'te kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar не збирає жодних даних. Усі вимірювання залишаються на цьому Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar کوئی ڈیٹا جمع نہیں کرتا۔ ہر پیمائش اسی Mac پر رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar không thu thập bất kỳ dữ liệu nào. Mọi phép đo đều ở lại trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar 不收集任何数据。所有测量数据都保留在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SimplyBar 不會收集任何資料。所有測量結果都保留在這台 Mac 上。"
          }
        }
      }
    },
    "Space used on the startup disk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
