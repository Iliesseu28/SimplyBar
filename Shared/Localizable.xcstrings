    "Free up space so macOS keeps running smoothly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفرغ بعض المساحة ليستمر macOS في العمل بسلاسة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS যাতে মসৃণভাবে চলতে থাকে, সেজন্য জায়গা খালি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Allibera espai perquè el macOS continuï funcionant bé."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvolněte místo, aby macOS dál fungoval plynule."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigør plads, så macOS fortsat kører glat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Speicherplatz frei, damit macOS weiterhin flüssig läuft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελευθερώστε χώρο για να συνεχίσει το macOS να λειτουργεί ομαλά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up space so macOS keeps running smoothly."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up space so macOS keeps running smoothly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up space so macOS keeps running smoothly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio para que macOS siga funcionando con fluidez."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio para que macOS siga funcionando sin problemas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vapauta tilaa, jotta macOS toimii edelleen sujuvasti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez de l'espace pour que macOS continue de bien fonctionner."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez de l'espace pour que macOS continue de bien fonctionner."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS સરળતાથી ચાલતું રહે તે માટે જગ્યા ખાલી કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פנו מקום כדי ש-macOS ימשיך לפעול בצורה חלקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगह ख़ाली करें ताकि macOS सुचारु रूप से चलता रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oslobodite prostor kako bi macOS i dalje radio glatko."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabadíts fel helyet, hogy a macOS továbbra is gördülékenyen fusson."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan ruang agar macOS tetap berjalan lancar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera spazio perché macOS continui a funzionare bene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSを快適に動作させるため、空き領域を増やしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ಸುಗಮವಾಗಿ ನಡೆಯುತ್ತಿರಲು ಸ್ಥಳವನ್ನು ಖಾಲಿ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 원활하게 작동하도록 공간을 확보하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS സുഗമമായി പ്രവർത്തിക്കാൻ ഇടം ഒഴിവാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS सुरळीत चालत राहावे म्हणून जागा मोकळी करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan ruang supaya macOS terus berjalan lancar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigjør plass så macOS fortsetter å kjøre jevnt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak ruimte vrij zodat macOS soepel blijft werken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ସୁଗମରେ ଚାଲୁରହିବା ପାଇଁ ସ୍ଥାନ ଖାଲି କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਗ੍ਹਾ ਖਾਲੀ ਕਰੋ ਤਾਂ ਜੋ macOS ਸੁਚਾਰੂ ਢੰਗ ਨਾਲ ਚੱਲਦਾ ਰਹੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwolnij miejsce, aby macOS nadal działał płynnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libere espaço para que o macOS continue funcionando bem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberte espaço para que o macOS continue a funcionar bem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliberează spațiu ca macOS să funcționeze în continuare fără probleme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите место для стабильной работы macOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoľnite miesto, aby macOS naďalej fungoval plynulo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprostite prostor, da bo macOS še naprej deloval tekoče."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigör utrymme så att macOS fortsätter att fungera smidigt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS சீராக இயங்க, இடத்தைக் காலி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS సాఫీగా నడుస్తూ ఉండేందుకు స్థలాన్ని ఖాళీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มพื้นที่ว่างเพื่อให้ macOS ทำงานได้อย่างราบรื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yer açın, böylece macOS sorunsuz çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звільніть місце, щоб macOS і далі працювала плавно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جگہ خالی کریں تاکہ macOS ہموار طریقے سے چلتا رہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy giải phóng dung lượng để macOS tiếp tục chạy mượt mà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请释放空间，让 macOS 保持流畅运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請釋放空間，讓 macOS 保持順暢運作。"
          }
        }
      }
