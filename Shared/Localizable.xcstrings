    "Activity Monitor shows which app uses it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض مراقب النشاط التطبيق الذي يستخدمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন অ্যাপ এটি ব্যবহার করছে, তা অ্যাক্টিভিটি মনিটরে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Monitor d’Activitat mostra quina app l’utilitza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor aktivity ukáže, která aplikace ho využívá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitetsovervågning viser, hvilken app der bruger den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktivitätsanzeige zeigt, welche App ihn nutzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Παρακολούθηση δραστηριότητας δείχνει ποια εφαρμογή τον χρησιμοποιεί."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity Monitor shows which app uses it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity Monitor shows which app uses it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity Monitor shows which app uses it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor de Actividad muestra qué app lo usa."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor de Actividad muestra qué app lo usa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimintojen seuranta näyttää, mikä appi sitä käyttää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Moniteur d'activité montre quelle app l'utilise."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Moniteur d'activité montre quelle app l'utilise."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કઈ ઍપ તેનો ઉપયોગ કરે છે, તે ઍક્ટિવિટી મૉનિટરમાં દેખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנטר הפעילות מציג איזו אפליקציה משתמשת בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन सा ऐप इसका उपयोग कर रहा है, यह गतिविधि मॉनिटर में दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor aktivnosti pokazuje koja ga aplikacija koristi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tevékenységfigyelő megmutatja, melyik app használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor Aktivitas menunjukkan app mana yang menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitoraggio Attività mostra quale app lo usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリが使用しているかは、アクティビティモニタで確認できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವ ಆ್ಯಪ್ ಅದನ್ನು ಬಳಸುತ್ತಿದೆ ಎಂಬುದನ್ನು ಆ್ಯಕ್ಟಿವಿಟಿ ಮಾನಿಟರ್ ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱이 사용 중인지 활성 상태 보기에서 확인할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏത് ആപ്പാണ് അത് ഉപയോഗിക്കുന്നതെന്ന് ആക്റ്റിവിറ്റി മോണിറ്റർ കാണിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणते ॲप ते वापरत आहे, हे ॲक्टिव्हिटी मॉनिटरमध्ये दिसते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor Aktiviti menunjukkan app yang menggunakannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitetsmonitor viser hvilken app som bruker den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activiteitenweergave toont welke app hem gebruikt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେଉଁ ଆପ ଏହାକୁ ବ୍ୟବହାର କରୁଛି, ତାହା ଆକ୍ଟିଭିଟି ମନିଟର ଦେଖାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਹੜੀ ਐਪ ਇਸਨੂੰ ਵਰਤ ਰਹੀ ਹੈ, ਇਹ ਐਕਟੀਵਿਟੀ ਮਾਨੀਟਰ ਵਿੱਚ ਦਿਖਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor aktywności pokazuje, która aplikacja go używa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Monitor de Atividade mostra qual app o está usando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Monitor de Atividade mostra que app o está a utilizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor activitate îți arată ce aplicație îl folosește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мониторинг системы покажет, какое приложение его использует."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor aktivity ukáže, ktorá aplikácia ho využíva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor dejavnosti pokaže, katera aplikacija ga uporablja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitetskontroll visar vilken app som använder den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த ஆப் அதைப் பயன்படுத்துகிறது என்பதை ஆக்டிவிட்டி மானிட்டர் காட்டும்."
