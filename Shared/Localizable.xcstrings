          "stringUnit": {
            "state": "translated",
            "value": "Preverjanje Maca…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar din Mac…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Mac சரிபார்க்கப்படுகிறது…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Mac ని తనిఖీ చేస్తోంది…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบ Mac ของคุณ…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz denetleniyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка вашого Mac…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے Mac کی جانچ ہو رہی ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra máy Mac của bạn…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查你的 Mac…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查你的 Mac…"
          }
        }
      }
    },
    "Closing the lid or choosing Sleep still puts the Mac to sleep.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدخل جهاز Mac في وضع السكون رغم ذلك عند إغلاق الغطاء أو عند وضعه في السكون يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঢাকনা বন্ধ করলে বা নিজে স্লিপে পাঠালে Mac তবুও স্লিপে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac entra igualment en repòs si tanques la tapa o el poses en repòs tu mateix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zavření víka nebo ručním uspání Mac přesto přejde do režimu spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'en går stadig på vågeblus, hvis du lukker låget eller selv sætter den på vågeblus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Deckel schließt oder den Ruhezustand selbst auswählst, schläft der Mac trotzdem ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Mac εξακολουθεί να μεταβαίνει σε ύπνο αν κλείσετε το καπάκι ή το θέσετε σε ύπνο οι ίδιοι."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the lid or choosing Sleep still puts the Mac to sleep."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the lid or choosing Sleep still puts the Mac to sleep."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the lid or choosing Sleep still puts the Mac to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac se pondrá en reposo igualmente si cierras la tapa o lo pones en reposo tú mismo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mac entrará en reposo de todas formas si cierras la tapa o la pones en reposo tú mismo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac menee silti nukkumaan, jos suljet kannen tai asetat sen nukkumaan itse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac se met quand même en veille si vous rabattez l'écran ou choisissez Suspendre l'activité."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac se met quand même en veille si vous rabattez l'écran ou choisissez Suspendre l'activité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઢાંકણ બંધ કરવાથી અથવા જાતે સ્લીપ કરવાથી Mac હજુ પણ સ્લીપમાં જાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac עדיין ייכנס למצב שינה אם תסגרו את המכסה או תעבירו אותו למצב שינה בעצמכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ढक्कन बंद करने या ख़ुद स्लीप में भेजने पर Mac फिर भी स्लीप में चला जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac i dalje prelazi u mirovanje ako zatvorite poklopac ili ga sami stavite u mirovanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac ettől még alvó módba lép, ha lecsukod a fedelet, vagy saját magad altatod el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tetap masuk mode tidur jika Anda menutup penutupnya atau menidurkannya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac va comunque in stop se chiudi il coperchio o lo metti in stop tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じたり、手動でスリープさせたりした場合は、Macはスリープします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಚ್ಚಳವನ್ನು ಮುಚ್ಚಿದರೆ ಅಥವಾ ನೀವೇ ಸ್ಲೀಪ್ ಮಾಡಿದರೆ Mac ಆದರೂ ಸ್ಲೀಪ್‌ಗೆ ಹೋಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫거나 직접 잠자기를 선택하면 Mac은 잠자기 상태가 됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലിഡ് അടച്ചാലോ നിങ്ങൾ സ്വയം സ്ലീപ്പ് ചെയ്താലോ Mac എന്തായാലും സ്ലീപ്പ് ആകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झाकण बंद केल्यास किंवा स्वतः स्लीप केल्यास Mac तरीही स्लीपमध्ये जातो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tetap akan tidur jika anda menutup penutupnya atau menidurkannya sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen går likevel i dvale hvis du lukker lokket eller setter den i dvale selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Mac gaat toch in de sluimerstand als je het deksel sluit of hem zelf laat sluimeren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଢାଙ୍କୁଣି ବନ୍ଦ କଲେ କିମ୍ବା ନିଜେ ସ୍ଲିପ କଲେ Mac ତଥାପି ସ୍ଲିପକୁ ଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਢੱਕਣ ਬੰਦ ਕਰਨ ਜਾਂ ਖੁਦ ਸਲੀਪ ਕਰਨ 'ਤੇ Mac ਫਿਰ ਵੀ ਸਲੀਪ ਵਿੱਚ ਚਲਾ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac i tak przejdzie w stan uśpienia, gdy zamkniesz pokrywę lub sam go uśpisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac ainda entra em repouso se você fechar a tampa ou colocá-lo em repouso manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac entra na mesma em pausa se fechar a tampa ou o puser em pausa manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul intră totuși în repaus dacă închizi capacul sau îl pui singur în repaus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac всё равно перейдёт в режим сна, если закрыть крышку или перевести его в сон вручную."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zatvorení krytu alebo ručnom uspaní Mac aj tak prejde do režimu spánku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac kljub temu preide v mirovanje, če zaprete pokrov ali ga sami preklopite v mirovanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datorn går ändå i vila om du stänger locket eller själv försätter den i vila."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூடியை மூடினாலோ நீங்களே ஸ்லீப் செய்தாலோ Mac ஸ்லீப்புக்குச் செல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మూత మూసినా లేదా మీరే స్లీప్ చేసినా Mac స్లీప్‌లోకి వెళ్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac จะยังคงพักเครื่องหากคุณปิดฝาหรือสั่งพักเครื่องเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapağı kapatırsanız veya Mac'i kendiniz uyutursanız Mac yine de uyku moduna geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac однаково перейде в режим сну, якщо закрити кришку або приспати його вручну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈھکن بند کرنے یا خود سلیپ کرنے پر Mac پھر بھی سلیپ میں چلا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac vẫn sẽ ngủ nếu bạn gập nắp hoặc tự cho máy ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上盖子或手动让 Mac 睡眠时，Mac 仍会进入睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔上螢幕或手動讓 Mac 睡眠時，Mac 仍會進入睡眠。"
          }
        }
      }
    },
