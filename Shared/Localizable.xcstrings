    "Nothing needs your attention right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يتطلب انتباهك حاليًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে কোনো কিছুতে আপনার মনোযোগ দেওয়ার প্রয়োজন নেই।"
          }
        },
        "ca": {
          "stringUnit": {
