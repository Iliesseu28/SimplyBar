          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence לא יכול לענות על כך. נסו שאלה אחרת על ה-Mac שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence इसका उत्तर नहीं दे सकता। अपने Mac के बारे में कोई और प्रश्न पूछकर देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ne može odgovoriti na to. Pokušajte s drugim pitanjem o svom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence erre nem tud válaszolni. Próbálj meg egy másik kérdést a Maceddel kapcsolatban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence tidak dapat menjawab itu. Coba pertanyaan lain tentang Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence non può rispondere a questa domanda. Prova con un'altra domanda sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceはこの質問に回答できません。Macについて別の質問をしてみてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ಇದಕ್ಕೆ ಉತ್ತರಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ನಿಮ್ಮ Mac ಕುರಿತು ಬೇರೆ ಪ್ರಶ್ನೆ ಕೇಳಿ ನೋಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 이 질문에 답변할 수 없습니다. Mac에 관한 다른 질문을 해 보십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-ന് ഇതിന് മറുപടി നൽകാനാവില്ല. നിങ്ങളുടെ Mac-നെക്കുറിച്ച് മറ്റൊരു ചോദ്യം ചോദിച്ചുനോക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence याचे उत्तर देऊ शकत नाही. तुमच्या Mac बद्दल दुसरा प्रश्न विचारून पाहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence tidak dapat menjawab soalan itu. Cuba soalan lain tentang Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kan ikke svare på det. Prøv et annet spørsmål om Macen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kan daar geen antwoord op geven. Probeer een andere vraag over je Mac."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ଏହାର ଉତ୍ତର ଦେଇପାରିବ ନାହିଁ। ଆପଣଙ୍କ Mac ବିଷୟରେ ଅନ୍ୟ ଏକ ପ୍ରଶ୍ନ ପଚାରି ଦେଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ਇਸਦਾ ਜਵਾਬ ਨਹੀਂ ਦੇ ਸਕਦਾ। ਆਪਣੇ Mac ਬਾਰੇ ਕੋਈ ਹੋਰ ਸਵਾਲ ਪੁੱਛ ਕੇ ਦੇਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nie może na to odpowiedzieć. Zadaj inne pytanie o swojego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence não pode responder a isso. Tente outra pergunta sobre o seu Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence não consegue responder a isso. Experimente outra pergunta sobre o seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nu poate răspunde la asta. Încearcă altă întrebare despre Mac-ul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence не может ответить на этот вопрос. Задайте другой вопрос о вашем Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence na to nedokáže odpovedať. Skúste inú otázku o svojom Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence na to ne more odgovoriti. Poskusite z drugim vprašanjem o svojem Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kan inte svara på det. Försök med en annan fråga om din Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-ஆல் இதற்குப் பதிலளிக்க முடியாது. உங்கள் Mac பற்றி வேறு கேள்வியைக் கேட்டுப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ఈ ప్రశ్నకు సమాధానం ఇవ్వలేకపోతోంది. మీ Mac గురించి వేరే ప్రశ్న అడిగి చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ไม่สามารถตอบคำถามนี้ได้ ลองถามคำถามอื่นเกี่ยวกับ Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence bunu yanıtlayamıyor. Mac'iniz hakkında başka bir soru deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence не може відповісти на це. Спробуйте інше запитання про ваш Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence اس کا جواب نہیں دے سکتا۔ اپنے Mac کے بارے میں کوئی اور سوال پوچھ کر دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence không thể trả lời câu hỏi này. Hãy thử một câu hỏi khác về máy Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能无法回答这个问题。请试试关于你的 Mac 的其他问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 無法回答這個問題。請試試關於你的 Mac 的其他問題。"
          }
        }
      }
    },
