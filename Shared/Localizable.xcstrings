        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisano na ovom Macu pomoću Appleove umjetne inteligencije na uređaju. Ništa ne napušta vaš Mac."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple eszközön futó MI-je írta ezen a Macen. Semmi sem hagyja el a Macedet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditulis di Mac ini oleh AI di perangkat dari Apple. Tidak ada yang keluar dari Mac Anda."
